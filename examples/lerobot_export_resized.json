{
  "version": 1,
  "format": "lerobot_v3",
  "fps": 15,
  "index_column": "canonical_time",
  "action": [
    "actions_target"
  ],
  "state": [
    "joint_positions",
    "gripper"
  ],
  "cameras": [
    {
      "source": "cam_flange",
      "width": 224,
      "height": 224
    },
    {
      "source": "cam_top",
      "width": 224,
      "height": 224
    },
    {
      "source": "cam_side",
      "width": 224,
      "height": 224
    }
  ],
  "trimming": {
    "mode": "all_present"
  },
  "task_description": "pick-and-place",
  "dataset_id": "nova/pick-and-place-resized"
}
